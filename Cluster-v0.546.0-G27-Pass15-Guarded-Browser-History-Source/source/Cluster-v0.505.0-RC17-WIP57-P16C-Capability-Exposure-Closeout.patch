+    userId: String(row.userId),
+    startsAt: row.startsAt.toISOString(),
+    endsAt: row.endsAt.toISOString(),
+    title: row.reason || "Preferred availability",
+    message: "This window overlaps a preferred availability period.",
+  }));
+}
