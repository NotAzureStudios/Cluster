index 0000000..29b03c5
--- /dev/null
+++ b/tools/scripts/checkpoint-naming-assertions.mjs
@@ -0,0 +1,24 @@
+import fs from "node:fs";
+import path from "node:path";
+
+const root = process.cwd();
+const read = (name) => fs.readFileSync(path.join(root, name), "utf8");
+const config = JSON.parse(read("VERSION_NAMING_CONVENTION.json"));
+const docs = read("CHECKPOINT_NAMING.md");
+const failures = [];
+const checks = [
+  ["pass pattern is explicit", config.passPattern === "^P[0-9]+[A-Z]?$"],
+  ["active checkpoint advances to P16C", config.currentCheckpoint?.pass === "P16C"],
+  ["human display separates identity layers", config.currentCheckpoint?.display === "v0.505.0 · RC17 · WIP57 · P16C"],
+  ["machine checkpoint is SemVer-compatible in shape", /^0\.505\.0-rc\.17\+work\.wip57\.p16c$/.test(config.currentCheckpoint?.machineCheckpointId || "")],
+  ["overlay filename follows canonical order", config.currentCheckpoint?.overlay === "Cluster-v0.505.0-RC17-WIP57-P16C-Capability-Exposure-Closeout-Overlay.zip"],
+  ["handoff names transitions directly", config.currentCheckpoint?.handoff === "Cluster-v0.505.0-RC17-WIP57-P16C-to-P17-Handoff.md"],
+  ["Phase10 retired from new artifact names", docs.includes("`Phase10` in filenames")],
+  ["historical artifact names remain immutable", config.historicalArtifactsAreImmutable === true],
+];
+for (const [label, ok] of checks) {
+  console.log(`${ok ? "PASS" : "FAIL"} ${label}`);
+  if (!ok) failures.push(label);
+}
+if (failures.length) process.exit(1);
+console.log(`Checkpoint naming assertions: ${checks.length}/${checks.length} PASS`);
