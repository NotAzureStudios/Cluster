# Consistent cross-platform text and native Windows scripts.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.go text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.qml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep media and install/build artifacts binary if intentionally committed.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
*.exe binary
*.msi binary
*.uasset binary
*.umap binary
