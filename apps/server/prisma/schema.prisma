generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  discordUserId String?  @unique
  discordUsername String?
  discordDisplayName String?
  discordAvatar String?
  discordLinkedAt DateTime?
  discordLastVerifiedAt DateTime?
  username       String   @unique
  passwordHash   String?
  accountState   String   @default("PASSWORD_CHANGE_REQUIRED")
  failedLoginCount Int    @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil    DateTime?
  passwordChangedAt DateTime?
  authenticationGeneration Int @default(1)
  verificationGeneration Int @default(1)
  firstLoginCompletedAt DateTime?
  employeeNumber String?  @unique
  displayName    String?
  email          String?
  avatarUrl      String?
  personalAccentColor String?
  preferences    String   @default("{}")
  privacyConsent  PrivacyConsentPreference?
  privacyDataRequests PrivacyDataRequest[]
  privacyLegalHolds PrivacyLegalHold[]
  policyAcceptances PolicyAcceptance[]
  behavioralAnalyticsEvents BehavioralAnalyticsEvent[]
  notificationInboxItems NotificationInboxItem[]
  notificationDigestDeliveries NotificationDigestDelivery[]
  studioFormReminderDeliveries StudioFormReminderDelivery[]
  studioFormAssignments StudioFormAssignment[]
  studioFormReviewerGrants StudioFormReviewer[]
  passwordResetRequests PasswordResetRequest[] @relation("PasswordResetRequester")
  passwordResetRequestsResolved PasswordResetRequest[] @relation("PasswordResetResolver")
  accountInvitations StudioAccountInvitation[] @relation("StudioAccountInvitationSubject")
  accountInvitationsIssued StudioAccountInvitation[] @relation("StudioAccountInvitationIssuer")
  accountInvitationsRevoked StudioAccountInvitation[] @relation("StudioAccountInvitationRevoker")
  pinHash        String?
  pinUpdatedAt   DateTime?
  failedPinCount Int      @default(0)
  pinLockedUntil DateTime?
  legalName      String?
  preferredName  String?
  pronouns       String?
  phoneNumber    String?
  alternatePhoneNumber String?
  alternateEmails String @default("[]")
  addressLine1   String?
  addressLine2   String?
  city           String?
  stateProvince  String?
  postalCode     String?
  country        String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  accountType    String   @default("employee")
  accessExpiresAt DateTime?
  invitedById    String?
  hideLegalName  Boolean  @default(true)
  hideLocation   Boolean  @default(false)
  customProfileFields String @default("{}")
  profileRevision Int    @default(1)
  notes          String?
  archived       Boolean  @default(false)
  lastSeenAt     DateTime?
  toolPermissions String   @default("{}")
  projectPermissions String @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studioFormSubmissions StudioFormSubmission[] @relation("StudioFormSubmissionUser")
  studioFormResponseDrafts StudioFormResponseDraft[]
  libraryCollectionGrants LibraryCollectionGrant[]
  convertedApplications StudioFormSubmission[] @relation("StudioApplicationConvertedUser")
  studioPolicyAcceptances StudioPolicyAcceptance[] @relation("StudioPolicyAcceptanceUser")
  packetCompletions PacketCompletion[] @relation("PacketCompletionUser")
  studioKnowledgeAssignments StudioKnowledgeAssignment[] @relation("StudioKnowledgeAssignmentUser")
  studioAnnouncementsCreated StudioAnnouncement[] @relation("StudioAnnouncementCreator")
  studioAnnouncementsPublished StudioAnnouncement[] @relation("StudioAnnouncementPublisher")
  studioOnboardingAssignments StudioOnboardingAssignment[] @relation("StudioOnboardingAssignmentUser")
  studioOnboardingRevocations StudioOnboardingAssignment[] @relation("StudioOnboardingAssignmentRevokedBy")
  studioOffboardingCases StudioOffboardingCase[] @relation("StudioOffboardingSubject")
  studioOffboardingCasesInitiated StudioOffboardingCase[] @relation("StudioOffboardingInitiator")
  studioOffboardingCasesReceived StudioOffboardingCase[] @relation("StudioOffboardingHandoff")
  studioOffboardingReturnsApproved StudioOffboardingCase[] @relation("StudioOffboardingReturnActor")
  accessRenewalsSubject StudioAccessRenewal[] @relation("AccessRenewalSubject")
  accessRenewalsRequested StudioAccessRenewal[] @relation("AccessRenewalRequester")
  accessRenewalsReviewed StudioAccessRenewal[] @relation("AccessRenewalReviewer")
  accessExpiryNotices StudioAccessExpiryNotice[]
  inventoryAccessRecipient StudioInventoryAccessRequest[] @relation("InventoryAccessRecipient")
  inventoryAccessRequested StudioInventoryAccessRequest[] @relation("InventoryAccessRequester")
  inventoryAccessReviewed StudioInventoryAccessRequest[] @relation("InventoryAccessReviewer")
  scopedGrantsSubject StudioScopedGrantRequest[] @relation("ScopedGrantSubject")
  scopedGrantsRequested StudioScopedGrantRequest[] @relation("ScopedGrantRequester")
  scopedGrantsReviewed StudioScopedGrantRequest[] @relation("ScopedGrantReviewer")

  sessions     Session[]
  deviceRegistrations DeviceRegistration[]
  authenticators Authenticator[]
  authenticatorRecoveryCodes AuthenticatorRecoveryCode[]
  authenticatorChallenges AuthenticatorChallenge[]
  serviceCredentialsCreated ServiceCredential[] @relation("ServiceCredentialCreator")
  memberships  WorkspaceMember[]
  assignedCards Card[] @relation("CardAssignee")
  comments      CardComment[]
  entityComments EntityComment[]
  entityCommentDrafts EntityCommentDraft[]
  entityCommentReadStates EntityCommentReadState[]
  entityCommentThreadReadStates EntityCommentThreadReadState[]
  entityCommentsAssigned EntityComment[] @relation("EntityCommentAssignee")
  entityCommentsResolved EntityComment[] @relation("EntityCommentResolver")
  activityEvents ActivityEvent[]
  timelineItems TimelineItem[]
  contextPacks ContextPack[]
  timeEntries TimeEntry[]
  scheduleBlocks ScheduleBlock[]
  libraryItems LibraryItem[]
  reviewingLibraryItems LibraryItem[] @relation("LibraryReviewer")
  libraryFavorites LibraryFavorite[] @relation("LibraryFavoriteUser")
  reviewComments ReviewComment[] @relation("ReviewCommentAuthor")
  reviewCommentsAssigned ReviewComment[] @relation("ReviewCommentAssignee")
  reviewCommentsResolved ReviewComment[] @relation("ReviewCommentResolver")
  reviewAssetsUploaded ReviewAsset[] @relation("ReviewAssetUploader")
  reviewAssetsCreated ReviewAsset[] @relation("ReviewAssetCreator")
  reviewAssetsOwned ReviewAsset[] @relation("ReviewAssetOwner")
  reviewAssetsReviewed ReviewAsset[] @relation("ReviewAssetReviewer")
  reviewAssetsApproved ReviewAsset[] @relation("ReviewAssetApprover")
  reviewAssetsModified ReviewAsset[] @relation("ReviewAssetLastModifier")
  avatarAudits AvatarAudit[]
  discordLinkChallenges DiscordLinkChallenge[]
  discordRoleProjections DiscordRoleProjection[]
  securityVerificationGrants SecurityVerificationGrant[]
  securityEventsAsActor SecurityAuditEvent[] @relation("SecurityAuditActor")
  securityEventsAsTarget SecurityAuditEvent[] @relation("SecurityAuditTarget")
  folderPermissions FolderPermission[]
  studioTeamMemberships StudioTeamMember[]
  ledStudioTeams StudioTeam[] @relation("StudioTeamLead")
  savedDataViews SavedDataView[] @relation("SavedDataViewOwner")
  employment Employment? @relation("EmploymentUser")
  managedEmployments Employment[] @relation("EmploymentManager")
  workforceStatus WorkforceStatus?
  presenceContext PresenceContext?
  workingPattern WorkingPattern?
  personSkills PersonSkill[]
  availabilityExceptions AvailabilityException[]
  teamRolesCreated TeamRole[] @relation("TeamRoleCreator")
  departmentLeadership Department[] @relation("DepartmentLead")
  projectMemberships ProjectMembership[] @relation("ProjectMembershipUser")
  personnelRecordTemplatesCreated PersonnelRecordTemplate[] @relation("PersonnelRecordTemplateCreator")
  personnelRecordsAsSubject PersonnelRecord[] @relation("PersonnelRecordSubject")
  personnelRecordsAsCustodian PersonnelRecord[] @relation("PersonnelRecordCustodian")
  personnelRecordsCreated PersonnelRecord[] @relation("PersonnelRecordCreator")
  personnelRecordsModified PersonnelRecord[] @relation("PersonnelRecordLastModifier")
  personnelRecordAttachmentsAdded PersonnelRecordAttachment[] @relation("PersonnelRecordAttachmentAdder")
  personnelRecordAmendments PersonnelRecordAmendment[] @relation("PersonnelRecordAmendmentActor")
  personnelRecordActions PersonnelRecordAction[] @relation("PersonnelRecordActionUser")
  personnelRecordAccessEvents PersonnelRecordAccessEvent[] @relation("PersonnelRecordAccessActor")

  @@index([accountState, lockedUntil])
  @@index([pinLockedUntil])
  @@index([archived, updatedAt])
}


model StudioAccountInvitation {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String
  issuedById     String
  revokedById    String?
  tokenHash      String   @unique
  authGeneration Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  consumedAt     DateTime?
  revokedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation("StudioAccountInvitationSubject", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User @relation("StudioAccountInvitationIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  revokedBy User? @relation("StudioAccountInvitationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId, createdAt])
  @@index([userId, consumedAt, revokedAt, expiresAt], map: "AccountInvite_user_lifecycle_idx")
}

model PasswordResetRequest {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("pending")
  requesterHint   String?
  resolvedById    String?
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User  @relation("PasswordResetRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("PasswordResetResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([resolvedById, resolvedAt])
}

model AvatarAudit {
  id            String   @id @default(cuid())
  userId        String
  actorUserId   String?
  previousUrl   String?
  newUrl        String
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  status        String   @default("pending")
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}


model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?
  authMethod String    @default("password")
  authenticationGeneration Int @default(1)
  deviceId   String?
  policyAcceptanceDigest String?
  revokedAt  DateTime?
  revocationReason String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  discordLinkChallenges DiscordLinkChallenge[]
  securityVerificationGrants SecurityVerificationGrant[]

  @@index([userId, lastSeenAt])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, deviceId, revokedAt, expiresAt])
  @@index([expiresAt])
}


model SecurityVerificationGrant {
  id                     String   @id @default(cuid())
  userId                 String
  sessionId              String
  purpose                String
  method                 String
  verifierStrength       String   @default("knowledge")
  verificationGeneration Int
  issuedAt               DateTime @default(now())
  expiresAt              DateTime
  singleUse              Boolean  @default(false)
  consumedAt             DateTime?
  revokedAt              DateTime?
  requiredReason         String?
  auditCorrelationId     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, purpose])
  @@index([userId, revokedAt, expiresAt])
  @@index([sessionId, revokedAt, expiresAt])
}

model DeviceRegistration {
  id                 String    @id @default(cuid())
  userId             String
  deviceId           String
  label              String?
  platform           String?
  userAgent          String?
  proofStatus        String    @default("unverified")
  proofAlgorithm     String?
  proofPublicKeySpki String?
  proofKeyFingerprint String?
  proofVerifiedAt    DateTime?
  proofLastSeenAt    DateTime?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, revokedAt, lastSeenAt])
  @@index([userId, proofStatus, revokedAt])
  @@index([deviceId, lastSeenAt])
}

model Authenticator {
  id                String   @id @default(cuid())
  userId            String
  kind              String
  label             String?
  state             String   @default("pending")
  strength          String   @default("mfa")
  encryptedSecret   String?
  credentialId      String?  @unique
  publicKeySpki     String?
  publicKeyAlgorithm String?
  signCount         BigInt   @default(0)
  transports        String   @default("[]")
  aaguid             String?
  attachment         String?
  discoverable       Boolean  @default(false)
  backupEligible     Boolean  @default(false)
  backupState        Boolean  @default(false)
  userVerification   String?
  metadata           String   @default("{}")
  enrolledAt         DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  compromisedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges AuthenticatorChallenge[]

  @@index([userId, state, kind])
  @@index([userId, revokedAt, lastUsedAt])
  @@index([credentialId, state])
}

model AuthenticatorRecoveryCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String   @unique
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, createdAt])
}

model AuthenticatorChallenge {
  id              String   @id @default(cuid())
  userId          String?
  authenticatorId String?
  flow            String
  kind            String
  challengeHash   String   @unique
  deviceId        String?
  rpId            String?
  expectedOrigin  String?
  context         String   @default("{}")
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  authenticator Authenticator? @relation(fields: [authenticatorId], references: [id], onDelete: Cascade)

  @@index([userId, flow, consumedAt, expiresAt])
  @@index([authenticatorId, consumedAt, expiresAt])
  @@index([expiresAt, consumedAt])
}

model ServiceCredential {
  id              String   @id @default(cuid())
  name            String
  credentialType  String
  scopes          String   @default("[]")
  tokenHash       String?  @unique
  tokenPrefix     String?
  secretFingerprint String?
  encryptedSecret String?
  createdById     String?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("ServiceCredentialCreator", fields: [createdById], references: [id], onDelete: SetNull)
  webhookEndpoints IntegrationWebhookEndpoint[] @relation("WebhookSigningCredential")

  @@index([credentialType, revokedAt, expiresAt])
  @@index([createdById, revokedAt, createdAt])
}

model IntegrationWebhookEndpoint {
  id                      String   @id @default(cuid())
  name                    String
  encryptedUrl            String
  urlDisplay              String
  eventTypes              String   @default("[]")
  workspaceId             String?
  projectId               String?
  signingCredentialId     String
  enabled                 Boolean  @default(true)
  allowPrivateNetwork     Boolean  @default(false)
  allowHttpPrivateNetwork Boolean  @default(false)
  timeoutMs               Int      @default(10000)
  createdById             String?
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  consecutiveFailures     Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  deliveries IntegrationWebhookDelivery[]
  signingCredential ServiceCredential @relation("WebhookSigningCredential", fields: [signingCredentialId], references: [id], onDelete: Restrict)

  @@index([workspaceId, enabled, projectId, createdAt])
  @@index([signingCredentialId])
  @@index([createdById, createdAt])
}

model IntegrationWebhookDelivery {
  id             String   @id @default(cuid())
  endpointId     String
  eventId        String
  eventType      String
  encryptedPayload String
  payloadHash    String
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastStatusCode Int?
  lastError      String?
  latencyMs      Int?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  endpoint IntegrationWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, createdAt])
  @@index([endpointId, createdAt])
  @@index([eventType, createdAt])
}

model DiscordLinkChallenge {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  stateHash   String   @unique
  redirectUri String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([expiresAt, consumedAt])
}

model SecurityAuditEvent {
  id               String   @id @default(cuid())
  event            String
  actorUserId      String?
  targetUserId     String?
  workspaceId      String?
  result           String
  reasonCode       String
  requestId        String?
  requestMethod    String?
  requestPath      String?
  sessionId        String?
  ipAddress        String?
  userAgent        String?
  metadata         String   @default("{}")
  sequence         Int?
  integrityVersion Int      @default(0)
  previousHash     String?
  eventHash        String?
  occurredAt       DateTime @default(now())

  actor  User? @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("SecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([event, occurredAt])
  @@index([targetUserId, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([integrityVersion, sequence])
  @@index([requestId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  description String?
  gitEnabled Boolean @default(false)
  archived  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  accountInvitations StudioAccountInvitation[]
  projects Project[]
  studioTeams StudioTeam[]
  departments Department[]
  jobRoles JobRole[]
  skills Skill[]
  employments Employment[]
  teamRoles TeamRole[]
  sourceRepositories SourceRepository[]
  integrationConnections IntegrationConnection[]
  externalEntityLinks ExternalEntityLink[]
  versionPolicies VersionPolicy[]
  savedDataViews SavedDataView[]
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String @default("member")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
}


model StudioTeam {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  department  String?
  departmentId String?
  leadUserId  String?
  color       String?
  permissionBundleIds String @default("[]")
  archived    Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departmentAuthority Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadUser  User? @relation("StudioTeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members   StudioTeamMember[]
  roles     TeamRole[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, updatedAt])
  @@index([leadUserId, archived])
  @@index([departmentId, archived])
}

model StudioTeamMember {
  id                String   @id @default(cuid())
  teamId            String
  userId            String
  roleLabel         String?
  teamRoleId        String?
  allocationPercent Int      @default(100)
  primaryMembership Boolean  @default(false)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team StudioTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamRole TeamRole? @relation(fields: [teamRoleId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId, archived, primaryMembership])
  @@index([teamId, archived])
  @@index([teamRoleId, archived])
}

model Department {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  parentId    String?
  leadUserId  String?
  color       String?
  iconId      String?
  archived    Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  leadUser User? @relation("DepartmentLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  employments Employment[]
  jobRoles JobRole[]
  teams StudioTeam[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, name])
  @@index([parentId, archived])
  @@index([leadUserId, archived])
}

model JobRole {
  id          String   @id @default(cuid())
  workspaceId String
  departmentId String?
  name        String
  description String?
  defaultCapacityHours Int?
  defaultMinimumHours Int?
  archived    Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employments Employment[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, name])
  @@index([departmentId, archived])
}

model Employment {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String   @unique
  departmentId String?
  jobRoleId    String?
  managerUserId String?
  employmentType String?
  workLocation String?
  startDate    DateTime?
  endDate      DateTime?
  capacityHours Int?
  minimumHours Int?
  active       Boolean  @default(true)
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation("EmploymentUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobRole JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  manager User? @relation("EmploymentManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, active, updatedAt])
  @@index([departmentId, active])
  @@index([jobRoleId, active])
  @@index([managerUserId, active])
}

model Skill {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  people PersonSkill[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, name])
}

model PersonSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     String   @default("working")
  years     Float?
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId, level])
  @@index([userId, primary])
}

model WorkingPattern {
  id           String   @id @default(cuid())
  userId       String   @unique
  timezone     String?
  hoursJson    String   @default("{}")
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkforceStatus {
  id                   String   @id @default(cuid())
  userId               String   @unique
  availability         String   @default("available")
  availabilityMessage  String?
  connectionVisibility String   @default("visible")
  focusState           String?
  declaredStatus       String?
  presenceDisclosure   String   @default("work_state")
  updatedByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availability, updatedAt])
  @@index([connectionVisibility, updatedAt])
  @@index([presenceDisclosure, updatedAt])
}

model PresenceContext {
  id             String   @id @default(cuid())
  userId         String   @unique
