// Published Packet snapshots are immutable source/provenance manifests, not a source ACL grant.
// No ordinary recipient endpoint may expose manifestJson or use it for raw Library downloads.
// Immutable recipient artifacts are detached from Library source storage. A
// release grants no direct Library access. Bounded detached text/PDF/image and
// PCM WAV excerpt adapters are opt-in; native-heavy formats are not supported.
model PacketReleaseDerivative {
  format    String @default("txt")
  id        String   @id @default(cuid())
  releaseId String
  position  Int
  content   Bytes
  sha256    String
  sizeBytes Int
  createdAt DateTime @default(now())
  release   PacketRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([releaseId, position])
}

// Authoritative evidence of a permitted detached Packet delivery issuance.
// This proves Cluster authorized and prepared bytes, not that the browser
// saved/received them. Never references or grants the Library source.
model PacketDeliveryReceipt {
  id             String   @id @default(cuid())
  releaseId      String
  recipientId    String
  kind           String
  position       Int?
  derivativeHash String
  sizeBytes      Int
  issuedAt       DateTime @default(now())
  release        PacketRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([releaseId, issuedAt, id])
  @@index([recipientId, issuedAt])
}

// A human-triggered assertion for one immutable published Packet release.
// Issuance receipts do not imply that a recipient read, saved or accepted it.
model PacketReleaseAcknowledgment {
  id             String   @id @default(cuid())
  releaseId      String
  recipientId    String
  versionLabel   String
  manifestSha256 String
  acknowledgedAt DateTime @default(now())
  release        PacketRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([releaseId, recipientId])
  @@index([releaseId, acknowledgedAt, id])
  @@index([recipientId, acknowledgedAt])
}

// Explicit requirement to acknowledge a particular immutable published release.
// Unlike ordinary completion, this record is never transferred to a new version.
model PacketReleaseRequirement {
  id             String   @id @default(cuid())
  releaseId      String
  recipientId    String
  assignedById   String
  manifestSha256 String
  dueAt          DateTime?
  assignedAt     DateTime @default(now())
  release        PacketRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  reminderDeliveries PacketReleaseReminderDelivery[]

  @@unique([releaseId, recipientId])
  @@index([recipientId, dueAt])
  @@index([releaseId, assignedAt, id])
}

// A committed, explicitly requested reminder about one exact Packet release.
// Requirement and release rows are preserved so compliance history survives edits.
model PacketReleaseReminderDelivery {
  id             String   @id @default(cuid())
  requirementId  String
  releaseId      String
  recipientId    String
  sentById       String
  manifestSha256 String
  sentAt         DateTime @default(now())
  requirement    PacketReleaseRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  release        PacketRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([requirementId, sentAt])
  @@index([recipientId, sentAt])
  @@index([releaseId, sentAt])
}

model PacketRelease {
  id                String   @id @default(cuid())
  packetDefinitionId String
  versionLabel      String
  manifestJson      String
  manifestSha256    String
  publishedById     String?
  publishedAt       DateTime @default(now())
  revokedAt         DateTime?
  revokedById       String?
  revocationReason  String?
  packetDefinition  PacketDefinition @relation(fields: [packetDefinitionId], references: [id], onDelete: Restrict)
  derivatives     PacketReleaseDerivative[]
  deliveryReceipts PacketDeliveryReceipt[]
  acknowledgments PacketReleaseAcknowledgment[]
  requirements PacketReleaseRequirement[]
  reminderDeliveries PacketReleaseReminderDelivery[]

  @@unique([packetDefinitionId, versionLabel])
  @@index([packetDefinitionId, publishedAt])
  @@index([packetDefinitionId, revokedAt])
}

// Managed Packages: the server stores detached signed artifacts and distribution
// policies, but native installation requires an independently authenticated agent.
model ManagedPackageSigningKey {
  fingerprint String @id
  label String
  publicKeyPem String
  disabledAt DateTime?
  createdAt DateTime @default(now())
}

model ManagedPackage {
  id String @id @default(cuid())
  key String @unique
  title String
  description String @default("")
  createdById String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  releases ManagedPackageRelease[]
  policies ManagedPackageRollout[]
  pins ManagedPackagePin[]
  seatRequirement ManagedPackageSeatRequirement?
}

// Optional package-to-inventory binding. Requires a valid, independently
// allocated digital/license seat IN ADDITION TO a reviewed Package grant.
// The binding is additive-only here; removing or retargeting it requires a
// separate reviewed governance workflow. Never stores Vault values.
model ManagedPackageSeatRequirement {
  packageId String @id
  assetId String
  revision Int @default(1)
  reason String
  configuredById String?
  createdAt DateTime @default(now())
  package ManagedPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  asset StudioInventoryAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId])
}

model ManagedPackageRelease {
  id String @id @default(cuid())
  packageId String
  version String
  platform String
  filename String
  manifestJson String
  manifestSha256 String
  signingKeyFingerprint String
  signature String
  artifactSha256 String
  artifactSize Int
  artifact Bytes?
  artifactStorageProvider String?
  artifactStorageTier String?
  artifactStorageKey String?
  publishedById String?
  publishedAt DateTime @default(now())
  revokedAt DateTime?
  revocationReason String?
  package ManagedPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  rollouts ManagedPackageRollout[]
  pins ManagedPackagePin[]
  @@unique([packageId, version, platform])
  @@index([packageId, publishedAt])
}

model ManagedPackageRollout {
  id String @id @default(cuid())
  packageId String
  channel String
  releaseId String
  state String @default("paused")
  percentage Int @default(0)
  revision Int @default(1)
  changedById String?
  changedAt DateTime @updatedAt
  package ManagedPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  release ManagedPackageRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  @@unique([packageId, channel])
}

model ManagedPackagePin {
  id String @id @default(cuid())
  packageId String
  deviceId String
  releaseId String
  reason String
  changedById String?
  active Boolean @default(true)
  revision Int @default(1)
  changedAt DateTime @updatedAt
  package ManagedPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  release ManagedPackageRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  @@unique([packageId, deviceId])
}

// F11: Distribution eligibility is a person-level entitlement, separate from
// signed releases, rollout selection, device pins and Inventory seat custody.
// Pending requests confer no access. Expiry is enforced on every target read.
model ManagedPackageEntitlement {
  id String @id @default(cuid())
  packageId String
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  revokedById String?
  revokedReason String?
  approvedById String
  approvedRequestId String
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([packageId, userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([packageId, revokedAt, expiresAt])
}

model ManagedPackageEntitlementRequest {
  id String @id @default(cuid())
  packageId String
  userId String
  action String // grant or extend
  requestedById String
  reviewedById String?
  expiresAt DateTime
  expectedRevision Int
  status String @default("pending")
  reason String
  reviewReason String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([packageId, status, createdAt])
  @@index([userId, status])
}

model ManagedPackageAuditEvent {
  id String @id @default(cuid())
  packageId String?
  actorId String?
  action String
  subjectId String
  detailsJson String
  createdAt DateTime @default(now())
  @@index([packageId, createdAt])
}


// v0.515: A signed Package download offers an isolated, time-limited device
// reporting session. Claims are NOT evidence of actual OS installation.
model ManagedPackageDeviceDeployment {
  id String @id @default(cuid())
  packageId String
  releaseId String
  deviceRegistrationId String
  userId String
  channel String
  state String @default("offered")
  revision Int @default(0)
  recoveryCount Int @default(0)
  challengeHash String
  challengeExpiresAt DateTime
  artifactSha256 String
  offeredAt DateTime @default(now())
  lastReportedAt DateTime?
  reports ManagedPackageDeviceReceipt[]
  @@index([deviceRegistrationId, offeredAt])
  @@index([packageId, offeredAt])
  @@index([releaseId, offeredAt])
}

// Immutable append-only, idempotency-keyed reports. Never interpret the
// device-claimed state as independently verified installer success.
model ManagedPackageDeviceReceipt {
  id String @id @default(cuid())
  deploymentId String
  eventId String
  sequence Int
  state String
  reportedArtifactSha256 String
  detail String @default("")
  reportedAt DateTime @default(now())
  deployment ManagedPackageDeviceDeployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  @@unique([deploymentId, eventId])
  @@unique([deploymentId, sequence])
  @@index([deploymentId, reportedAt])
}

// F09: Two-person approval for extending identity access, not implicit entitlement grants.
model StudioAccessRenewal {
  id String @id @default(cuid())
  subjectUserId String
  requestedById String
  reviewedById String?
  status String @default("pending")
  requestedExpiresAt DateTime
  previousExpiresAt DateTime
  expectedProfileRevision Int
  reason String
  reviewReason String?
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  personnelRecordId String?
  subject User @relation("AccessRenewalSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  requestedBy User @relation("AccessRenewalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("AccessRenewalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([subjectUserId, status, requestedAt])
  @@index([status, requestedAt])
}

// Per-window, per-stage committed evidence; a retry never sends duplicates.
model StudioAccessExpiryNotice {
  id String @id @default(cuid())
  userId String
  expiresAt DateTime
  stage String
  notifiedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, expiresAt, stage])
  @@index([stage, notifiedAt])
}

// Durable per-credential deadline evidence. Only public identity/expiry metadata is
// retained; neither Vault ciphertext nor secret identifiers enter Notifications.
// Concurrent workers race on this unique tuple and commit the inbox projection
// in the same PostgreSQL transaction. A later extension is a new deadline.
model StudioInventoryExpiryNotice {
  id String @id @default(cuid())
  subjectKind String // digital_seat | assigned_key | vault_credential
  subjectId String
  expiresAt DateTime
  stage String // seven_days | one_day | expired
  notifiedAt DateTime @default(now())

  @@unique([subjectKind, subjectId, expiresAt, stage])
  @@index([stage, notifiedAt])
  @@index([subjectKind, subjectId])
}

// F10: governed, bounded Project-member AccessRule issuance and expiry extension.
// Authoritative access remains in AccessRule; pending requests grant nothing.
model StudioScopedGrantRequest {
  id String @id @default(cuid())
  subjectUserId String
  requestedById String
  reviewedById String?
  targetKind String @default("project")
  targetId String
  workspaceId String
  operation String // grant | extend
  accessRuleId String?
  expectedRuleUpdatedAt DateTime?
  previousExpiresAt DateTime?
  level String
  expiresAt DateTime
  expectedProfileRevision Int
  reason String
  reviewReason String?
  status String @default("pending")
  grantedRuleId String?
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  personnelRecordId String?
  subject User @relation("ScopedGrantSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  requestedBy User @relation("ScopedGrantRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("ScopedGrantReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([targetKind, targetId, subjectUserId, status])
  @@index([status, requestedAt])
  @@index([subjectUserId, requestedAt])
}

// Vault-governed domain inventory. DNS challenge proves control of a zone;
// a binding is an operator-managed intent, NOT automatic DNS/TLS provisioning.
model StudioManagedDomain {
  id                 String   @id
  domain             String   @unique
  note               String?
  registrar          String?
  expiresOn          DateTime?
  verificationToken  String
  verificationState  String   @default("pending")
  verifiedAt         DateTime?
  bindingHostname    String?  @unique
  bindingServerLabel String?
  bindingServerInstanceId String?
  bindingDnsType     String?
  bindingDnsTarget   String?
  bindingNote        String?
  connectionMode     String?
  connectionProvider String?
  connectionWebPort  Int?
  connectionApiPort  Int?
  connectionPublicPort Int?
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([verificationState])
  @@index([bindingServerInstanceId])
  @@index([expiresOn])
}
