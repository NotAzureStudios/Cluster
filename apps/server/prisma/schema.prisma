/** One dispatch for each eligible recipient and event revision. Changing
 * attendees or times creates a new revision without replaying old recipients. */
/** A cancellation belongs to the original (timezone-anchored) occurrence, not
 * the current series revision. Restoring deletes this row without affecting history. */
model CalendarEventOccurrenceException {
  id              String @id @default(cuid())
  calendarEventId String
  occurrenceStartsAt DateTime
  status          String @default("cancelled")
  movedStartsAt   DateTime?
  movedEndsAt     DateTime?
  actorUserId     String
  reason          String?
  createdAt       DateTime @default(now())
  event           CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@unique([calendarEventId, occurrenceStartsAt])
  @@index([calendarEventId, createdAt])
}

/** The original timezone-anchored recurrence instant is the immutable key.
 * Individual responses never mutate series-wide meeting attendance/RSVP. */
model CalendarMeetingOccurrenceResponse {
  id String @id @default(cuid())
  calendarEventId String
  occurrenceStartsAt DateTime
  userId String
  rsvpStatus String?
  attendanceStatus String?
  revision Int @default(1)
  updatedByUserId String
  updatedAt DateTime @updatedAt
  event CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@unique([calendarEventId, occurrenceStartsAt, userId])
}

