// Resume marker is committed in the same transaction as each metadata chunk.
// Lease recovery can replay a chunk, but cannot apply it twice.
// Provenance of tree-wide archive/trash operations. Absence of a mark means
// the record was independently archived/trashed and must not be auto-restored.
// Kept independently of LibraryItem to preserve audit evidence on disposition.
// Retained even when Library authority is later retired. No cascading FK to
// LibraryItem: disposal evidence must survive removal of the original record.
model LibraryDispositionRequest {
  id               String    @id @default(cuid())
  itemId           String
  requestKey       String    @unique
  requestedById    String
  reason           String
  status           String    @default("PENDING_REVIEW")
  requestedAt      DateTime  @default(now())
  reviewAfter      DateTime
  originalRevision Int
  snapshotSha256   String
  snapshotJson     String
  cancelledAt      DateTime?
  cancelledById    String?
  decisionRevision Int       @default(0)
  snapshotVersion  Int       @default(1)
  evidence         LibraryDispositionEvidence[]
  decisions        LibraryDispositionDecision[]
  quarantinePlans  LibraryQuarantinePlan[]

  @@index([status, reviewAfter])
  @@index([itemId, status, requestedAt])
  @@index([requestedById, requestedAt])
}

model LibraryDispositionEvidence {
  id          String   @id @default(cuid())
  requestId   String
  actorId     String
  eventType   String
  occurredAt  DateTime @default(now())
  detailsJson String
  request     LibraryDispositionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
}

// R66: independent decision authority. Append-only decisions never release bytes.
// requestDecisionRevision provides a strict per-request event order; request
// optimistic revisions fence competing reviewers in Serializable transactions.
model LibraryDispositionDecision {
  id                       String   @id @default(cuid())
  requestId                String
  actorId                  String
  action                   String
  reason                   String
  snapshotVersion          Int
  snapshotSha256           String
  requestDecisionRevision  Int
  occurredAt               DateTime @default(now())
  request                  LibraryDispositionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, requestDecisionRevision])
  @@index([requestId, occurredAt])
  @@index([actorId, occurredAt])
}

