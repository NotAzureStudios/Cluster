    "setup:status": "tsx src/scripts/setup-status.ts",
    "storage:sync": "tsx src/scripts/sync-storage.ts",
    "storage:verify": "tsx src/scripts/verify-storage.ts",
    "media:worker": "node dist/workers/media-worker.js",
    "media:worker:dev": "tsx src/workers/media-worker.ts",
