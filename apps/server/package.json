{
  "name": "@cluster/server",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:studio": "node ../../tools/scripts/database-command.mjs studio",
    "db:generate": "node ../../tools/scripts/database-command.mjs generate",
    "db:validate": "node ../../tools/scripts/database-command.mjs validate",
    "db:deploy": "node ../../tools/scripts/database-command.mjs deploy",
    "db:status": "node ../../tools/scripts/database-command.mjs status",
    "db:doctor": "node ../../tools/scripts/database-command.mjs doctor",
    "auth:bootstrap-owner": "tsx src/scripts/bootstrap-owner.ts",
