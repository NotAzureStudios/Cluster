    "@prisma/adapter-pg": "7.9.1",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "pdfjs-dist": "5.7.284",
    "pdf-lib": "1.17.1",
    "@redis/client": "6.3.0",
    "sharp": "0.35.5",
    "@napi-rs/canvas": "0.1.96"
